{
	// Sources only. Without this, `tsc` also reads the built declarations in
	// dist/, where the same `Window.camefrom` global is declared a second time,
	// and a checkout that has been built stops type-checking.
	"include": ["src"],
	"compilerOptions": {
		// Environment setup & latest features
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		// TypeScript 7 no longer pulls in @types automatically. Naming bun keeps
		// bun:test resolvable and, just as usefully, keeps Node's globals out of
		// a package that only ever runs in a browser.
		"types": ["bun"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",
		"allowJs": true,

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		// Best practices
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,

		// Some stricter flags (disabled by default)
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noPropertyAccessFromIndexSignature": false
	}
}
